<?xml version="1.0" encoding="UTF-8"?>
<suite name="Order Session API" verbose="1" configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.ordersession.reporting.AllureTestListener"/>
    </listeners>

    <!-- Negative + security first (no env); then integration -->
    <test name="Order Session E2E" preserve-order="true">
        <classes>
            <class name="com.ordersession.tests.OrderSessionUnauthorizedTests"/>
            <class name="com.ordersession.tests.PaymentTokenSessionValidationTests"/>
            <class name="com.ordersession.tests.WalletEntrySessionValidationTests"/>
            <class name="com.ordersession.tests.PaymentTokenSessionNotFoundTests"/>
            <class name="com.ordersession.tests.WalletEntrySessionNotFoundTests"/>
            <class name="com.ordersession.tests.PaymentTokenSessionIntegrationTests"/>
            <class name="com.ordersession.tests.WalletEntrySessionIntegrationTests"/>
        </classes>
    </test>
</suite>
